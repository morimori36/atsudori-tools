{
  "name": "atsudori-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "npm run typecheck && vite build && node scripts/build-notices.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:webkit": "npm run build && playwright test --config playwright.webkit.config.ts",
    "audit:public": "node scripts/audit-public.ts",
    "schema:write": "node scripts/export-schema.ts",
    "test:private": "vitest run --config private-regression.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
