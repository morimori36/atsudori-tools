{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morimori36.github.io/atsudori-tools/schemas/conversion-profile-v2.schema.json",
  "title": "atsudori-tools conversion profile v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "atsudori-tools/conversion-profile"
    },
    "schemaVersion": {
      "const": 2
    },
    "engine": {
      "const": "bounded-template/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "atsudori-tools/collection"
        },
        "schemaVersion": {
          "const": 1
        }
      },
      "required": [
        "format",
        "schemaVersion"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "definitionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "format",
        "version",
        "definitionSha256"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalogId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "catalogId",
        "revision",
        "sha256"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "sha256"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "sources"
      ]
    },
    "program": {
      "$ref": "#/$defs/template"
    },
    "output": {
      "$ref": "#/$defs/shape"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "engine",
    "id",
    "version",
    "input",
    "target",
    "catalog",
    "provenance",
    "program",
    "output",
    "checksum"
  ],
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "maxLength": 200,
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "template": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "$ref": "#/$defs/json"
            }
          },
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "get"
            },
            "path": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "minItems": 2
            }
          },
          "required": [
            "op",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "object"
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 200,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/template"
              }
            }
          },
          "required": [
            "op",
            "fields"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "array"
            },
            "values": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/template"
              }
            }
          },
          "required": [
            "op",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "concat"
            },
            "values": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/template"
              }
            }
          },
          "required": [
            "op",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "text"
            },
            "values": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/template"
              }
            }
          },
          "required": [
            "op",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "map"
            },
            "source": {
              "enum": [
                "members",
                "snaps",
                "ranks",
                "items"
              ]
            },
            "body": {
              "$ref": "#/$defs/template"
            },
            "key": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "op",
            "source",
            "body"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "lookup"
            },
            "values": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 200,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/json"
              }
            },
            "key": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "op",
            "values",
            "key"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "ifNull"
            },
            "value": {
              "$ref": "#/$defs/template"
            },
            "yes": {
              "$ref": "#/$defs/template"
            },
            "no": {
              "$ref": "#/$defs/template"
            }
          },
          "required": [
            "op",
            "value",
            "yes",
            "no"
          ]
        }
      ]
    },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "minLength": 1,
                "maxLength": 200,
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "additionalProperties": {
                "$ref": "#/$defs/shape"
              }
            }
          },
          "required": [
            "type",
            "properties"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "record"
            },
            "values": {
              "$ref": "#/$defs/shape"
            }
          },
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/shape"
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "type",
            "items",
            "max"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "choice"
            },
            "options": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/shape"
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "options"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "decimal": {
              "type": "boolean"
            },
            "enum": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "minItems": 1
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}
