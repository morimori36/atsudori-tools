{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Economy scenario v4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "atsudori-tools/economy-scenario"
    },
    "schemaVersion": {
      "const": 4
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "startDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lbPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "playId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "skipId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "playsPerDay": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "skipsPerDay": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "lbPerDay",
        "skipPercent",
        "playId",
        "skipId",
        "playsPerDay",
        "skipsPerDay"
      ]
    },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "levels": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bandId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "bandId",
              "level"
            ]
          }
        },
        "claimEveryMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5270400
        },
        "minutesPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      },
      "required": [
        "enabled",
        "levels",
        "claimEveryMinutes",
        "minutesPerDay"
      ]
    },
    "dailyClaims": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "includeEvents": {
      "type": "boolean"
    },
    "fixedSources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "claims": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sourceId",
          "claims"
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "catalogId",
    "startDate",
    "endDate",
    "rank",
    "live",
    "studio",
    "dailyClaims",
    "includeEvents",
    "fixedSources"
  ]
}
