{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morimori36.github.io/atsudori-tools/schemas/collection-v1.schema.json",
  "title": "atsudori-tools collection v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "atsudori-tools/collection"
    },
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "members": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cardId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "trainingStage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "awakeningStage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "liveSkillLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "gekisouSkillLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "displayedStatsOverride": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "performance",
              "technic",
              "visual"
            ],
            "properties": {
              "performance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "technic": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "visual": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "required": [
          "cardId",
          "level",
          "trainingStage",
          "awakeningStage",
          "liveSkillLevel",
          "gekisouSkillLevel"
        ]
      }
    },
    "snaps": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supportCardId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "supportCardId",
          "level",
          "rank"
        ]
      }
    },
    "characterRanks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "characterProgress": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stamps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "songClears": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bondRankTotal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "liveClears": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skillLevel2": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skillLevel3": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skillLevel4": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "skillLevel5": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": []
      }
    },
    "bandItems": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "catalogId",
    "members",
    "snaps",
    "characterRanks",
    "bandItems"
  ]
}
