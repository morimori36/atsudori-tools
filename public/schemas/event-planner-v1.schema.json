{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morimori36.github.io/atsudori-tools/schemas/event-planner-v1.schema.json",
  "title": "atsudori-tools event planner v1",
  "description": "Independent event planner input. See docs/event-planner.md for units, precision and search limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "targetPt",
    "currentPt",
    "currentCP",
    "normalMultiplier",
    "minutesPerRun",
    "maxUnits",
    "normal",
    "challenge",
    "bases"
  ],
  "properties": {
    "format": {
      "const": "atsudori-tools/event-planner"
    },
    "schemaVersion": {
      "const": 1
    },
    "targetPt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentPt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentCP": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "normalMultiplier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "minutesPerRun": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 90071992547409.9,
      "multipleOf": 0.01
    },
    "maxUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "normal": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled",
          "rank",
          "bonus"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "rank": {
            "enum": [
              "S",
              "A",
              "B",
              "C"
            ]
          },
          "bonus": {
            "type": "number",
            "minimum": 0,
            "maximum": 90071992547409.9,
            "multipleOf": 0.01
          }
        }
      }
    },
    "challenge": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled",
          "rank",
          "bonus"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "rank": {
            "enum": [
              "SS",
              "S",
              "A",
              "B"
            ]
          },
          "bonus": {
            "type": "number",
            "minimum": 0,
            "maximum": 90071992547409.9,
            "multipleOf": 0.01
          }
        }
      }
    },
    "bases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "challenge"
      ],
      "properties": {
        "normal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "S",
            "A",
            "B",
            "C"
          ],
          "properties": {
            "S": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt",
                "cp"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "A": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt",
                "cp"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "B": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt",
                "cp"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "C": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt",
                "cp"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cp": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        "challenge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SS",
            "S",
            "A",
            "B"
          ],
          "properties": {
            "SS": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "S": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "A": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "B": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pt"
              ],
              "properties": {
                "pt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      }
    }
  }
}
