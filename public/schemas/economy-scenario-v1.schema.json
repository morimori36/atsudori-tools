{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Economy scenario v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "atsudori-tools/economy-scenario"
    },
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "startDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lbPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipPercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "playId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "skipId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "playsPerDay": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "skipsPerDay": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "lbPerDay",
        "skipPercent",
        "playId",
        "skipId",
        "playsPerDay",
        "skipsPerDay"
      ]
    },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "levels": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bandId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "bandId",
              "level"
            ]
          }
        },
        "claimEveryMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5270400
        },
        "minutesPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      },
      "required": [
        "enabled",
        "levels",
        "claimEveryMinutes",
        "minutesPerDay"
      ]
    },
    "dailyClaims": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "claimDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "points": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "fullCollection": {
            "type": "boolean"
          },
          "buyLimited": {
            "type": "boolean"
          }
        },
        "required": [
          "eventId",
          "claimDate",
          "points",
          "fullCollection",
          "buyLimited"
        ]
      }
    },
    "purchases": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "offerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "alreadyPurchased": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "offerId",
          "quantity",
          "alreadyPurchased"
        ]
      }
    },
    "pass": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            "startsOn": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "claimDates": {
              "type": "array",
              "maxItems": 3660,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          },
          "required": [
            "passId",
            "startsOn",
            "claimDates"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fixedSources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "claims": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sourceId",
          "claims"
        ]
      }
    },
    "externalIncome": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "amounts": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resourceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "resourceId",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "date",
          "amounts"
        ]
      }
    },
    "allocations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "purpose": {
            "enum": [
              "gacha",
              "lb",
              "reserve",
              "other"
            ]
          },
          "costs": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resourceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  }
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "resourceId",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "date",
          "purpose",
          "costs"
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "catalogId",
    "startDate",
    "endDate",
    "rank",
    "live",
    "studio",
    "dailyClaims",
    "events",
    "purchases",
    "pass",
    "fixedSources",
    "externalIncome",
    "allocations"
  ]
}
