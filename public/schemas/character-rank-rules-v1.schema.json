{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morimori36.github.io/atsudori-tools/schemas/character-rank-rules-v1.schema.json",
  "title": "Character rank rules v1",
  "description": "Structural schema; ascending thresholds, uniqueness, arithmetic bounds and exact catalog binding are also validated by the application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "engine",
    "id",
    "version",
    "catalog",
    "provenance",
    "manualProgress",
    "achievements",
    "rankThresholds"
  ],
  "properties": {
    "format": {
      "const": "atsudori-tools/character-rank-rules"
    },
    "schemaVersion": {
      "const": 1
    },
    "engine": {
      "const": "achievement-thresholds/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogId",
        "revision",
        "sha256"
      ],
      "properties": {
        "catalogId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "manualProgress": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "enum": [
              "stamps",
              "songClears",
              "bondRankTotal",
              "liveClears"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "stage",
          "thresholds",
          "exp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "members",
              "snaps",
              "training",
              "awakening",
              "snapRank",
              "skills",
              "stamps",
              "songClears",
              "bondRankTotal",
              "liveClears"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "stage": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "thresholds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "uniqueItems": true
          },
          "exp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "rankThresholds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "exp"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "exp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
